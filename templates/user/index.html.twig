{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('assets/styles/css/globals.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components/admin_table.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components/admin_header.css') }}" rel="stylesheet">
{% endblock %}

{% block title %}Liste des employés{% endblock %}

{% block admin_header %}
    {{ include('admin/components/admin_header.html.twig', {
    'header_mode': 'vertical' 
    }) }}
{%endblock%}

{% block body %}
    <h1>Liste des utilisateurs</h1>

    <section class="table-layout">
        <section class="table-container">
            <section class="table-header">

                <article class="table-header-column col-1">
                    <h1 class="column-title">Nom de famille</h1>
                </article>

                <article class="table-header-column col-1">
                    <h1 class="column-title">Prénom</h1>
                </article>

                <article class="table-header-column col-1">
                    <h1 class="column-title">Status</h1>
                </article>

                <article class="table-header-column col-1">
                    <h1 class="column-title">Email</h1>
                </article>

                <article class="table-header-column col-2">
                    <h1 class="column-title">Edition</h1>
                </article>
            </section>

            {% for user in users %}

            <section class="table-rows">

                <article class="table-rows-column col-1">
                    <p> {{ user.lastname }} </p>
                </article>

                <article class="table-rows-column col-1">
                    <p> {{ user.firstname }} </p>
                </article>

                <article class="table-rows-column col-1">
                    <p> {{ user.status }} </p>
                </article>

                <article class="table-rows-column col-1">
                    <p> {{ user.email }} </p>
                </article>

                <article class="table-rows-column col-2">
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}"><button class="btn-edit">{{ button_label|default('✏️Modifier') }}</button></a>
                    <a href="{{ path('app_user_delete', {'id': user.id}) }}"><button class="btn-del">{{ button_label|default('🗑️Supprimer') }}</button></a>
                </article>

            </section>

            {% else %} 

            <section class="table-rows">
                <article class="table-rows-column">
                    <h1 class="column-content">Veuillez renseigner la base de donnée</h1>
                </article>
            </section>

            {% endfor %}
        </section>
    </section>

    <section class="additionnal-actions">
        <a href="{{ path('app_user_new') }}"><button class="btn-add">{{ button_label|default('✏️Ajouter') }}</button></a>
    </section>

{% endblock %}
