{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('assets/styles/css/components/login_form.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components.css') }}" rel="stylesheet">
{% endblock %}

{% block title %}Connectez-vous!{% endblock %}

{% block body %}
    <section class="login-block">
        <img src="/assets/images/logo-david-kenos-blanc.png" alt="logo">
        <section class="login-title">
            <p>Hâte de nous retrouver ?</p><br><h1>Connectes-toi</h1>
        </section>
        
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="Identifiant" required autofocus>
            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="Mot de passe" required>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            {#
                Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                See https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Remember me</label>
                </div>
            #}

            <button class="btn-login" type="submit">
                Connexion
            </button>

        </form>

    </section>
{% endblock %}
