{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('assets/styles/css/globals.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components/admin_table.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/styles/css/components/admin_header.css') }}" rel="stylesheet">
{% endblock %}

{% block title %}Article index{% endblock %}

{% block body %}
    <h1>Article index</h1>

    <section class="table-layout">
        <section class="table-container">
            <section class="table-header">

                <article class="table-header-column col-2">
                    <h1 class="column-title">Titre</h1>
                </article>

                <article class="table-header-column col-2">
                    <h1 class="column-title">Contenu</h1>
                </article>

                <article class="table-header-column col-1">
                    <h1 class="column-title">Date</h1>
                </article>

                <article class="table-header-column col-2">
                    <h1 class="column-title">Edition</h1>
                </article>
            </section>
            {% for article in articles %}
            <section class="table-rows">

                <article class="table-rows-column col-2">
                    <p> {{ article.atitle }} </p>
                </article>

                <article class="table-rows-column col-2">
                    <p> {{ article.content }} </p>
                </article>

                <article class="table-rows-column col-1">
                    <p> {{ article.date ? article.date|date('Y-m-d') : '' }} </p>
                </article>

                <article class="table-rows-column col-2">
                    <a href="{{ path('app_admin_article_edit', {'id': article.id}) }}"><button class="btn-edit">{{ button_label|default('✏️Modifier') }}</button></a>
                    <a href="{{ path('app_admin_article_delete', {'id': article.id}) }}"><button class="btn-del">{{ button_label|default('🗑️Supprimer') }}</button></a>
                </article>
            </section>

            {% else %} 

            <section class="table-rows">
                <article class="table-rows-column">
                    <h1 class="column-content">Veuillez renseigner la base de donnée</h1>
                </article>
            </section>

            {% endfor %}
        </section>
    </section>

    <section class="additionnal-actions">
        <a href="{{ path('app_admin_article_new') }}"><button class="btn-add">{{ button_label|default('✏️Ajouter') }}</button></a>
    </section>

{% endblock %}
