{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
<div class="form-fields">
    <div data-flex="6" class="form-data-block ">

        <div class="form-object">
            {{ form_label(form.atitle) }}
            {{ form_widget(form.atitle) }}
        </div>
            
        <div class="form-object-errors">
            {{ form_errors(form.atitle) }}
        </div>

        <div class="form-object">
            {{ form_label(form.content) }}
            {{ form_widget(form.content) }}
        </div>

        <div class="form-object-errors">
            {{ form_errors(form.content) }}
        </div>

    <div class="btn-block">
        <button class="btn-style btn-avg">{{ button_label|default('Save') }}</button>
    </div>

    </div>

    <div data-flex="4" class="form-data-block">
        <div class="form-object-line">
            <p>Ajoutez une image<p>
            <div>
                <button type="button" class="btn-upload add-articlepic" data-collection-holder-class="articlepics-collection"><i class="fa-solid fa-plus"></i></button>
            </div>
        </div>
        <div class="">
            {% if form.articlepics|length == 0 %}
                <p class="missing-pic">Vous n'avez pas encore de photos ajoutées pour cette actualité.</p>
            {% endif %}
        </div>
        <ul 
            class="articlepics-collection upload-display" 
            data-index="{{ form.articlepics|length }}"
            data-prototype="
                {{ include('admin_article/_form_picfile.html.twig', {articlepic: form.articlepics.vars.prototype})|e('html_attr') }}
            "
        >
            {% for articlepic in form.articlepics %}
                <li class="articlepic-item">
                    {{ include('admin_article/_form_picfile.html.twig', {articlepic: articlepic})}}
                </li>
            {% endfor %}
        
        </ul>

    </div>
</div>


{{ form_end(form) }}
