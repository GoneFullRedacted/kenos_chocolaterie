{% extends 'base_admin.html.twig' %}

{% block title %}Location{% endblock %}

{% block body %}
    <h1>Location</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ location.id }}</td>
            </tr>
            <tr>
                <th>Locname</th>
                <td>{{ location.locname }}</td>
            </tr>
            <tr>
                <th>Locslug</th>
                <td>{{ location.locslug }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_location_index') }}">back to list</a>

    <a href="{{ path('app_location_edit', {'id': location.id}) }}">edit</a>

    {{ include('admin/location/_delete_form.html.twig') }}
{% endblock %}
