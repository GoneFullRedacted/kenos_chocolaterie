<ul class="artcilepics-preview">
	{% for articlepic in articlepics %}
		<li class="atriclepic-item">
			<div class="overlay hidden">
				<div class="window">
					<div class="form-line">
						{{ form_label(articlepic.file) }}
						{{ form_widget(articlepic.file) }}
						<div class="errors">
							{{ form_errors(articlepic.file) }}
						</div>
					</div>
					<div class="form-line">
						{{ form_label(articlepic.alttxt) }}
						{{ form_widget(articlepic.alttxt) }}
						<div class="errors">
							{{ form_errors(articlepic.alttxt) }}
						</div>
					</div>
					<button class="validate-button" type="button">Valider</button>
				</div>
			</div>
			<div class="articlepic-preview-container">
				<img src="{{ articlepic.src }}" alt="{{ articlepic.alttxt }}">
				<div class="buttons-container">
					<button type="button" class="edit-btn" title="Editer"><i class="fa-solid fa-pen"></i></button>
					<button type="button" class="delete-btn" title="Supprimer"><i class="fa-solid fa-trash"></i></button>
				</div>
			</div>
		</li>
	{% endfor %}
</ul>

<script>
	function addFormToCollection() {
		const item = document.createElement('li');

		item.querySelector('.overlay').classList.remove('hidden');

		const editButton = item.querySelector('.edit-btn');
		editButton.addEventListener('click', () => {
			deleteItem(editButton);
		});

		const deleteButton = item.querySelector('.delete-btn');
		deleteButton.addEventListener('click', () => {
			deleteItem(deleteButton);
		});

		// Event listener validate button
	}

	function editItem(editButton) {
		const parentLi = editButton.closest('li');
		const overlay = parentLi.querySelector('.overlay');

		overlay.classList.remove('hidden');
	}

	function deleteItem(deleteButton) {
		deleteButton.closest('li').remove();
	}


	function valdidateItem(validateButton) {
		const condition = false; // check if inputs are properly filled

		const parentLi = validateButton.closest('li');
		const overlay = parentLi.querySelector('.overlay');

		if (condition) {
			overlay.classList.add('hidden');
		}
		else {
			if (confirm('Êtes-vous sûr(e) de vouloir annuler l\'ajout de cette image ?')) {
				parentLi.remove();
			}
		}
	}
</script>
